{
    "manifest_version": 3,
    "name": "Bookmark Set Manager",
    "version": "2.0",
    "description": "Manage different sets of bookmarks in your Bookmarks Bar with automatic syncing",
    "permissions": ["bookmarks"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": "icon128.png"
    },
    "icons": {
        "16": "icon16.png",
        "19": "icon19.png",
        "32": "icon32.png",
        "38": "icon38.png",
        "48": "icon48.png",
        "128": "icon128.png"
    }
  }