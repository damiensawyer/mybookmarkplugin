{
    "manifest_version": 3,
    "name": "Bookmark Folder Copier",
    "version": "1.0",
    "description": "Copy bookmarks from Other Bookmarks folders to Bookmarks Bar",
    "permissions": ["bookmarks"],
    "action": {
      "default_popup": "popup.html",
      "default_icon": {
        "16": "icon16.jpeg",
        "48": "icon48.jpeg",
        "128": "icon128.jpeg"
      }
    },
    "icons": {
      "16": "icon16.jpeg",
      "48": "icon48.jpeg",
      "128": "icon128.jpeg"
    }
  }